    "test:perf": "node scripts/perf-check.mjs",
    "test:flow": "node scripts/full-flow.mjs",
    "test:scene-restart": "node scripts/scene-restart.mjs"
  },
  "dependencies": {
    "lucide": "^1.80.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
